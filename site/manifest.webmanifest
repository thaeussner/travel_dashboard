    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add cost", "url": "./costs/#add" },
    { "name": "Trip data", "url": "./emissions/#editor" }
  ]
